nest.add(
    'simulation',
    [
        # 'acs_pubcov_covariate_scaled',
        'acs_pubcov_save_scaled_nontargeted',
        'acs_pubcov_save_scaled_tevim',
        # 'acs_pubcov_save_scaled',
    ]
)

nest.add(
    'loss',
    [
        'accuracy',
        # 'balanced_accuracy'
    ]
)

nest.add(
    'tolerance',
    TOLERANCE
)

nest.add(
    'numbins',
    NUM_BINS
)

nest.add_aggregate('method_res_estimate', list)
nest.add_aggregate('method_res_comparators', list)

@nest.add_target_with_env(localenv)
def get_detector_test(env, outdir, c):
    targets = [
        join(outdir, 'estimateJOB.txt'),
        join(outdir, 'resultestimateJOB.csv'),
        join(outdir, 'explainerJOB.pkl'),
    ]
    orig_cmd = [
        'get_detector_test.py',
        '--do-aggregate',
        '--decomposition',
        SIMULATION_SETTINGS[c['simulation']]['decomposition'],
        '--seed-offset',
        0,
        '--loss',
        c['loss'],
        '--combos %s' % SIMULATION_SETTINGS[c['simulation']]['combos'] if 'combos' in SIMULATION_SETTINGS[c['simulation']] else '',
        '--train-data-template',
        SIMULATION_SETTINGS[c['simulation']]['train_data_file'],
        '--source-data-template',
        SIMULATION_SETTINGS[c['simulation']]['source_file'],
        '--target-data-template',
        SIMULATION_SETTINGS[c['simulation']]['target_file'],
        '--grouping-data',
        SIMULATION_SETTINGS[c['simulation']]['grouping_file'],
        '--mdl',
        SIMULATION_SETTINGS[c['simulation']]['revised_mdl'],
        DO_GRID_SEARCH,
        # '--gridsearch-poly',
        SIMULATION_SETTINGS[c['simulation']]['clip'],
        '--tolerance',
        c['tolerance'],
        '--prevalence',
        MIN_PREVALENCE,
        '--num-bins',
        c['numbins'],
        '--one-sided-test' if ONE_SIDED_TEST else '',
        SIMULATION_SETTINGS[c['simulation']]['test_greater'],
        '--significance-level',
        SIGNIFICANCE_LEVEL,
        '--num-bootstrap',
        NUM_BOOTSTRAP,
        '--save-detectors',
        '--log ${TARGETS[0]}',
        '--result-file ${TARGETS[1]}',
        '--explainer-out-file ${TARGETS[2]}',
    ]
    cmd = [
        'python run_script.py',
        '--cluster',
        localenv['cluster'],
        '--target-template-file',
        '${TARGETS[0]},${TARGETS[1]},${TARGETS[2]}',
        '--num-jobs',
        NUM_JOBS,
        '--run-line="%s"' % ' '.join(map(str, orig_cmd)),
    ]
    c['method_res_estimate'].append(targets[1])
    return env.Command(
        targets,
        [],
        ' '.join(map(str, cmd)))

