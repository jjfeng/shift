@nest.add_target_with_env(localenv)
def train_ml(env, outdir, c):
    targets = [
        join(outdir, 'mdl.pkl'),
        join(outdir, 'log_ml.txt'),
    ]
    orig_cmd = [
        'train_ml.py',
        '--seed-offset',
        0,
        SIMULATION_SETTINGS[c['simulation']]['weight'],
        '--param-dict',
        'casestudy/model_dict.json',
        '--model',
        c['mdl'],
        '--data',
        SIMULATION_SETTINGS[c['simulation']]['train_data_file'],
        '--mdl ${TARGETS[0]}',
        '--log ${TARGETS[1]}',
    ]
    cmd = ['python'] + orig_cmd
    return env.Command(
        targets,
        [],
        ' '.join(map(str, cmd)))

nest.add(
    'loss',
    [
        # 'ppv',
        'accuracy',
        # 'balanced_accuracy'
    ]
)

nest.add(
    'tolerance',
    TOLERANCE
)

nest.add(
    'prevalence',
    MIN_PREVALENCE
)

nest.add(
    'numbins',
    NUM_BINS
)

nest.add(
    'decomposition',
    lambda c: SIMULATION_SETTINGS[c['simulation']]['decomposition']
)

nest.add_aggregate('method_res_estimate', list)
nest.add_aggregate('method_res_comparators', list)

@nest.add_target_with_env(localenv)
def get_detector_test(env, outdir, c):
    targets = [
        join(outdir, 'estimateJOB.txt'),
        join(outdir, 'resultestimateJOB.csv'),
        join(outdir, 'explainerJOB.pkl'),
    ]
    orig_cmd = [
        'get_detector_test.py',
        '--do-aggregate',
        '--decomposition',
        c['decomposition'],
        '--filter-independent-features' if FILTER_INDEPENDENT_FEATURES else '',
        '--seed-offset',
        0,
        '--loss',
        c['loss'],
        '--combos %s' % SIMULATION_SETTINGS[c['simulation']]['combos'] if 'combos' in SIMULATION_SETTINGS[c['simulation']] else '',
        '--train-data-template',
        SIMULATION_SETTINGS[c['simulation']]['train_data_file'],
        '--source-data-template',
        SIMULATION_SETTINGS[c['simulation']]['source_file'],
        '--target-data-template',
        SIMULATION_SETTINGS[c['simulation']]['target_file'],
        '--grouping-data',
        SIMULATION_SETTINGS[c['simulation']]['feature_file'],
        '--mdl ${SOURCES[0]}',
        SIMULATION_SETTINGS[c['simulation']]['pred_threshold'] if 'pred_threshold' in SIMULATION_SETTINGS[c['simulation']] else '',
        DO_GRID_SEARCH,
        # '--gridsearch-poly',
        SIMULATION_SETTINGS[c['simulation']]['clip'],
        '--tolerance',
        c['tolerance'],
        '--prevalence',
        c['prevalence'],
        '--num-bins',
        c['numbins'],
        '--one-sided-test' if ONE_SIDED_TEST else '',
        SIMULATION_SETTINGS[c['simulation']]['test_greater'],
        '--significance-level',
        SIGNIFICANCE_LEVEL,
        '--num-bootstrap',
        NUM_BOOTSTRAP,
        '--save-detectors',
        '--log ${TARGETS[0]}',
        '--result-file ${TARGETS[1]}',
        '--explainer-out-file ${TARGETS[2]}',
    ]
    cmd = [
        'python run_script.py',
        '--cluster',
        localenv['cluster'],
        '--target-template-file',
        '${TARGETS[0]},${TARGETS[1]},${TARGETS[2]}',
        '--num-jobs',
        NUM_JOBS,
        '--run-line="%s"' % ' '.join(map(str, orig_cmd)),
    ]
    c['method_res_estimate'].append(targets[1])
    return env.Command(
        targets,
        [
            c['train_ml'][0],
        ],
        ' '.join(map(str, cmd)))

@nest.add_target_with_env(localenv)
def interpret_detectors(env, outdir, c):
    targets = [
        join(outdir, 'detectorsJOB.txt'),
        join(outdir, 'detectorsJOB.csv'),
    ]
    orig_cmd = [
        'interpret_detectors.py',
        '--seed-offset',
        0,
        '--decomposition',
        c['decomposition'],
        '--loss',
        c['loss'],
        '--train-data-template',
        SIMULATION_SETTINGS[c['simulation']]['train_data_file'],
        '--source-data-template',
        SIMULATION_SETTINGS[c['simulation']]['source_file'],
        '--target-data-template',
        SIMULATION_SETTINGS[c['simulation']]['target_file'],
        '--grouping-data',
        SIMULATION_SETTINGS[c['simulation']]['feature_file'],
        '--explainer-file ${SOURCES[1]}',
        DO_GRID_SEARCH,
        '--combos %s' % SIMULATION_SETTINGS[c['simulation']]['combos'] if 'combos' in SIMULATION_SETTINGS[c['simulation']] else '',
        '--significance-level',
        SIGNIFICANCE_LEVEL,
        '--mdl ${SOURCES[0]}',
        SIMULATION_SETTINGS[c['simulation']]['pred_threshold'] if 'pred_threshold' in SIMULATION_SETTINGS[c['simulation']] else '',
        '--log ${TARGETS[0]}',
        '--result-file ${TARGETS[1]}',
    ]
    cmd = [
        'python run_script.py',
        '--is-short',
        '--cluster',
        localenv['cluster'],
        '--target-template-file',
        '${TARGETS[0]},${TARGETS[1]}',
        '--num-jobs',
        1,
        '--run-line="%s"' % ' '.join(map(str, orig_cmd)),
    ]
    return env.Command(
        targets,
        [
            c['train_ml'][0],
            c['get_detector_test'][2]
        ],
        ' '.join(map(str, cmd)))
    
@nest.add_target_with_env(localenv)
def get_comparator(env, outdir, c):
    targets = [
        join(outdir, 'comp_estimateJOB.txt'),
        join(outdir, 'comp_resultestimateJOB.csv'),
    ]
    orig_cmd = [
        'get_comparators.py',
        '--seed-offset',
        0,
        '--decomposition',
        c['decomposition'],
        '--loss',
        c['loss'],
        '--train-data-template',
        SIMULATION_SETTINGS[c['simulation']]['train_data_file'],
        '--source-data-template',
        SIMULATION_SETTINGS[c['simulation']]['source_file'],
        '--target-data-template',
        SIMULATION_SETTINGS[c['simulation']]['target_file'],
        '--grouping-data',
        SIMULATION_SETTINGS[c['simulation']]['feature_file'],
        DO_GRID_SEARCH,
        '--combos %s' % SIMULATION_SETTINGS[c['simulation']]['combos'] if 'combos' in SIMULATION_SETTINGS[c['simulation']] else '',
        '--significance-level',
        SIGNIFICANCE_LEVEL,
        '--mdl ${SOURCES[0]}',
        SIMULATION_SETTINGS[c['simulation']]['pred_threshold'] if 'pred_threshold' in SIMULATION_SETTINGS[c['simulation']] else '',
        '--log ${TARGETS[0]}',
        '--result-file ${TARGETS[1]}',
    ]
    cmd = [
        'python run_script.py',
        # '--is-short',
        '--cluster',
        localenv['cluster'],
        '--target-template-file',
        '${TARGETS[0]},${TARGETS[1]}',
        '--num-jobs',
        1,
        '--run-line="%s"' % ' '.join(map(str, orig_cmd)),
    ]
    c['method_res_comparators'].append(targets[1])
    return env.Command(
        targets,
        [
            c['train_ml'][0],
        ],
        ' '.join(map(str, cmd)))

@nest.add_target_with_env(localenv)
def summarize_tests(env, outdir, c):
    targets = [
        join(outdir, 'test_summary.pdf'),
    ]
    cmd = [
        'python plot_test_summary.py',
        '--target-data-file',
        SIMULATION_SETTINGS[c['simulation']]['target_file'],
        '--decomposition',
        c['decomposition'],
        '--significance-level',
        SIGNIFICANCE_LEVEL,
        '--grouping-data',
        SIMULATION_SETTINGS[c['simulation']]['grouping_file'],
        '--decomp-file ${SOURCES[1]}',
        '--comparator-file ${SOURCES[0]}',
        '--result-file ${TARGETS[0]}'
    ]
    return env.Command(
        targets,
        [
            c['method_res_comparators'],
            c['method_res_estimate'],
        ],
        ' '.join(map(str, cmd)))

@nest.add_target_with_env(localenv)
def eval_model_fixes(env, outdir, c):
    targets = [
        join(outdir, 'log_eval_explanation_JOB.txt'),
    ]
    cmd = [
        'python eval_model_fixes.py',
        '--source-data-file',
        SIMULATION_SETTINGS[c['simulation']]['source_file'],
        '--target-data-file',
        SIMULATION_SETTINGS[c['simulation']]['target_file'],
        '--decomposition',
        c['decomposition'],
        '--grouping-data',
        SIMULATION_SETTINGS[c['simulation']]['grouping_file'],
        '--decomp-file ${SOURCES[1]}',
        '--comparator ${SOURCES[0]}',
        '--mdl ${SOURCES[2]}',
        '--max-train',
        100000,
        '--num-obs',
        10000,
        '--num-top',
        '1',
        '--num-weights-combined-comparator',
        NUM_WEIGHTS_COMBINED_COMPARATOR,
        '--result-file ${TARGETS[0]}'
    ]
    return env.Command(
        targets,
        [
            c['method_res_comparators'],
            c['method_res_estimate'],
            c['train_ml'][0],
        ],
        ' '.join(map(str, cmd)))

