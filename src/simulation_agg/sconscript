    'simulation',
    [
        # 'dim4_linear_aggmoreshift',
        'dim10_linear_aggbiggergroupratioeighty',
        # 'dim4_norm2_aggsubgroup',
        'dim10_norm2_aggsubgroupsmallcoeff',
