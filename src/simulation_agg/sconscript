@nest.add_target_with_env(localenv)
def make_source_train_data(env, outdir, c):
    targets = [
        join(outdir, 'source_train_dataJOB.csv'),
        join(outdir, 'source_train_logJOB.txt'),
    ]

    orig_cmd = [
        'generate_data.py',
        '--x-dist',
        SIMULATION_SETTINGS[c['simulation']]['x_dist'],
        '--num-obs',
        NUM_OBS_MDL_TRAIN,
        '--seed-offset',
        0,
        '--x-mean',
        SIMULATION_SETTINGS[c['simulation']]['x_source_mean'],
        '--beta',
        SIMULATION_SETTINGS[c['simulation']]['source_beta'],
        '--nonlinear' if SIMULATION_SETTINGS[c['simulation']]['nonlinear_source'] else '',
        '--x-scale',
        SIMULATION_SETTINGS[c['simulation']]['x_source_scale'],
        '--out-file ${TARGETS[0]}',
        '--log ${TARGETS[1]}',
    ]
    cmd = [
        'python run_script.py',
        '--is-short',
        '--cluster',
        localenv['cluster'],
        '--target-template-file',
        '${TARGETS[0]},${TARGETS[1]}',
        '--num-jobs',
        1,
        '--run-line="%s"' % ' '.join(map(str, orig_cmd)),
    ]
    return env.Command(
        targets,
        [],
        ' '.join(map(str, cmd)))

@nest.add_target_with_env(localenv)
def train_ml(env, outdir, c):
    targets = [
        join(outdir, 'mdl.pkl'),
        join(outdir, 'log_ml.txt'),
    ]
    orig_cmd = [
        'train_ml.py',
        '--seed-offset',
        0,
        '--model',
        SIMULATION_SETTINGS[c['simulation']]['mdl_type'],
        '--param',
        'simulation_comparators/model_dict.json',
        '--data ${SOURCES[0]}',
        '--mdl ${TARGETS[0]}',
        '--log ${TARGETS[1]}',
    ]
    cmd = ['python'] + orig_cmd
    return env.Command(
        targets,
        c['make_source_train_data'],
        ' '.join(map(str, cmd)))

nest.add_aggregate('source_data', dict)
nest.add_aggregate('target_data', dict)
nest.add_aggregate('source_data_gen', list)
nest.add_aggregate('target_data_gen', list)
nest.add(
    'numobs',
    NUM_OBS
)
@nest.add_target_with_env(localenv)
def make_source_data(env, outdir, c):
    targets = [
        join(outdir, 'source_dataJOB.csv'),
        join(outdir, 'sourceJOB.pkl'),
        join(outdir, 'log_source_dataJOB.txt'),
    ]
    c['source_data_gen'].append(targets[1])
    c['source_data'][c['numobs']] = targets[0]

    orig_cmd = [
        'generate_data.py',
        '--x-dist',
        SIMULATION_SETTINGS[c['simulation']]['x_dist'],
        '--seed-offset',
        1,
        '--num-obs',
        c['numobs'],
        '--x-mean',
        SIMULATION_SETTINGS[c['simulation']]['x_source_mean'],
        '--beta',
        SIMULATION_SETTINGS[c['simulation']]['source_beta'],
        '--nonlinear' if SIMULATION_SETTINGS[c['simulation']]['nonlinear_source'] else '',
         '--x-scale',
        SIMULATION_SETTINGS[c['simulation']]['x_source_scale'],
        '--out-file ${TARGETS[0]}',
        '--out-data-gen ${TARGETS[1]}',
        '--log ${TARGETS[2]}',
    ]
    cmd = [
        'python run_script.py',
        '--is-short',
        '--cluster',
        localenv['cluster'],
        '--target-template-file',
        '${TARGETS[0]},${TARGETS[1]},${TARGETS[2]}',
        '--num-jobs',
        NUM_JOBS,
        '--run-line="%s"' % ' '.join(map(str, orig_cmd)),
    ]
    return env.Command(
        targets,
        [],
        ' '.join(map(str, cmd)))

@nest.add_target_with_env(localenv)
def make_target_data(env, outdir, c):
    targets = [
        join(outdir, 'target_dataJOB.csv'),
        join(outdir, 'targetJOB.pkl'),
        join(outdir, 'log_target_dataJOB.txt'),
    ]
    c['target_data_gen'].append(targets[1])
    c['target_data'][c['numobs']] = targets[0]

    orig_cmd = [
        'generate_data.py',
        '--seed-offset',
        2,
        '--x-dist',
        SIMULATION_SETTINGS[c['simulation']]['x_dist'],
        '--num-obs',
        c['numobs'],
        '--x-mean',
        SIMULATION_SETTINGS[c['simulation']]['x_target_mean'],
        '--beta',
        SIMULATION_SETTINGS[c['simulation']]['target_beta'],
        '--nonlinear' if SIMULATION_SETTINGS[c['simulation']]['nonlinear_target'] else '',
        '--subgroupshift' if SUBGROUP_SHIFT_TARGET else '',
        '--source-beta',
        SIMULATION_SETTINGS[c['simulation']]['source_beta'],
        '--x-source-mean',
        SIMULATION_SETTINGS[c['simulation']]['x_source_mean'],
        '--x-scale',
        SIMULATION_SETTINGS[c['simulation']]['x_target_scale'],
        '--x-source-scale',
        SIMULATION_SETTINGS[c['simulation']]['x_source_scale'],
        '--out-file ${TARGETS[0]}',
        '--out-data-gen ${TARGETS[1]}',
        '--log ${TARGETS[2]}',
    ]
    cmd = [
        'python run_script.py',
        '--is-short',
        '--cluster',
        localenv['cluster'],
        '--target-template-file',
        '${TARGETS[0]},${TARGETS[1]},${TARGETS[2]}',
        '--num-jobs',
        NUM_JOBS,
        '--run-line="%s"' % ' '.join(map(str, orig_cmd)),
    ]
    return env.Command(
        targets,
        [],
        ' '.join(map(str, cmd)))

nest.pop('numobs')

nest.add(
    'loss',
    [
        # 'outcome',
        'accuracy',
        # 'balanced_accuracy'
    ]
)

nest.add(
    'tolerance',
    TOLERANCE
)

nest.add(
    'numbins',
    NUM_BINS
)

nest.add_aggregate('method_res_estimate', list)
nest.add_aggregate('method_res_comparators', list)

nest.add(
    'numobs',
    NUM_OBS
)

@nest.add_target_with_env(localenv)
def get_detector_test(env, outdir, c):
    targets = [
        join(outdir, 'estimateJOB.txt'),
        join(outdir, 'resultestimateJOB.csv'),
        join(outdir, 'explainerJOB.pkl'),
    ]
    orig_cmd = [
        'get_detector_test.py',
        '--do-aggregate',
        '--decomposition',
        SIMULATION_SETTINGS[c['simulation']]['decomposition'],
        '--seed-offset',
        0,
        '--loss',
        c['loss'],
        '--combos %s' % SIMULATION_SETTINGS[c['simulation']]['combos'] if 'combos' in SIMULATION_SETTINGS[c['simulation']] else '',
        '--train-data-template ${SOURCES[0]}',
        '--source-data-template ${SOURCES[1]}',
        '--target-data-template ${SOURCES[2]}',
        '--source-data-generator ${SOURCES[4]}',
        '--target-data-generator ${SOURCES[5]}',
        '--grouping-data',
        SIMULATION_SETTINGS[c['simulation']]['grouping_file'],
        '--mdl ${SOURCES[3]}',
        DO_GRID_SEARCH,
        # '--gridsearch-poly',
        IS_ORACLE,
        '--tolerance',
        c['tolerance'],
        '--prevalence',
        MIN_PREVALENCE,
        '--num-bins',
        c['numbins'],
        '--one-sided-test' if ONE_SIDED_TEST else '',
        SIMULATION_SETTINGS[c['simulation']]['test_greater'],
        '--significance-level',
        SIGNIFICANCE_LEVEL,
        '--num-bootstrap',
        NUM_BOOTSTRAP,
        '--save-detectors',
        '--log ${TARGETS[0]}',
        '--result-file ${TARGETS[1]}',
        '--explainer-out-file ${TARGETS[2]}',
    ]
    cmd = [
        'python run_script.py',
        '--cluster',
        localenv['cluster'],
        '--target-template-file',
        '${TARGETS[0]},${TARGETS[1]},${TARGETS[2]}',
        '--num-jobs',
        NUM_JOBS,
        '--run-line="%s"' % ' '.join(map(str, orig_cmd)),
    ]
    c['method_res_estimate'].append(targets[1])
    return env.Command(
        targets,
        [
            c['make_source_train_data'][0],
            c['source_data'][c['numobs']],
            c['target_data'][c['numobs']],
            c['train_ml'][0],
            c['source_data_gen'][0],
            c['target_data_gen'][0],
        ],
        ' '.join(map(str, cmd)))

@nest.add_target_with_env(localenv)
def get_comparator(env, outdir, c):
    targets = [
        join(outdir, 'comp_estimateJOB.txt'),
        join(outdir, 'comp_resultestimateJOB.csv'),
    ]
    orig_cmd = [
        'get_comparators.py',
        '--seed-offset',
        0,
        '--decomposition',
        SIMULATION_SETTINGS[c['simulation']]['decomposition'],
        '--loss',
        c['loss'],
        '--train-data-template ${SOURCES[0]}',
        '--source-data-template ${SOURCES[1]}',
        '--target-data-template ${SOURCES[2]}',
        '--source-data-generator ${SOURCES[3]}',
        '--target-data-generator ${SOURCES[4]}',
        '--grouping-data',
        SIMULATION_SETTINGS[c['simulation']]['grouping_file'],
        '--combos %s' % SIMULATION_SETTINGS[c['simulation']]['combos'] if 'combos' in SIMULATION_SETTINGS[c['simulation']] else '',
        DO_GRID_SEARCH,
        '--significance-level',
        SIGNIFICANCE_LEVEL,
        '--mdl ${SOURCES[5]}',
        '--log ${TARGETS[0]}',
        '--result-file ${TARGETS[1]}',
    ]
    cmd = [
        'python run_script.py',
        '--is-short',
        '--cluster',
        localenv['cluster'],
        '--target-template-file',
        '${TARGETS[0]},${TARGETS[1]}',
        '--num-jobs',
        NUM_JOBS_COMP,
        '--run-line="%s"' % ' '.join(map(str, orig_cmd)),
    ]
    c['method_res_comparators'].append(targets[1])
    return env.Command(
        targets,
        [
            c['make_source_train_data'][0],
            c['source_data'][c['numobs']],
            c['target_data'][c['numobs']],
            c['source_data_gen'][0],
            c['target_data_gen'][0],
            c['train_ml'][0],
        ],
        ' '.join(map(str, cmd)))

nest.pop('numobs')

@nest.add_target_with_env(localenv)
def summarize(env, outdir, c):
    res_estimate = ','.join([join('simulation_agg', a) for a in c['method_res_estimate']])
    print("results files", res_estimate)
    targets = [
        join(outdir, 'res_estimate.csv'),
        join(outdir, 'summary.csv'),
        join(outdir, 'coverage_agg.pdf'),
        join(outdir, 'coverage_detail.pdf'),
    ]
    cmd = [
        'python plot_simulation_agg.py',
        '--result-files-estimate',
        res_estimate,
        '--num-jobs',
        NUM_JOBS,
        '--significance-level',
        SIGNIFICANCE_LEVEL,
        '--one-sided-test' if ONE_SIDED_TEST else '',
        '--plot-component',
        SIMULATION_SETTINGS[c['simulation']]['plot_component'],
        '--csv-file-estimate ${TARGETS[0]}',
        '--summary-csv ${TARGETS[1]}',
        '--coverage-agg ${TARGETS[2]}',
        '--coverage-detail ${TARGETS[3]}',
    ]
    return env.Command(
        targets,
        [
            c['method_res_estimate'],
        ],
        ' '.join(map(str, cmd)))

@nest.add_target_with_env(localenv)
def summarize_comparators(env, outdir, c):
    res_estimate = ','.join([join('simulation_agg', a) for a in c['method_res_estimate']])
    res_comparators = ','.join([join('simulation_agg', a) for a in c['method_res_comparators']])
    print("results estimate files", res_estimate)
    print("results comparator files", res_comparators)
    targets = [
        join(outdir, 'res_comparators.csv'),
        join(outdir, 'summary_comparators.csv'),
        join(outdir, 'coverage_comparators_agg.pdf'),
        join(outdir, 'coverage_comparators_detail.pdf'),
    ]
    cmd = [
        'python plot_simulation_agg.py',
        '--result-files-estimate',
        res_estimate,
        '--result-files-comparators',
        res_comparators,
        '--num-jobs',
        NUM_JOBS_COMP,
        '--significance-level',
        SIGNIFICANCE_LEVEL,
        '--one-sided-test' if ONE_SIDED_TEST else '',
        '--plot-component',
        SIMULATION_SETTINGS[c['simulation']]['plot_component'],
        '--csv-file-estimate ${TARGETS[0]}',
        '--summary-csv ${TARGETS[1]}',
        '--coverage-agg ${TARGETS[2]}',
        '--coverage-detail ${TARGETS[3]}',
    ]
    return env.Command(
        targets,
        [
            c['method_res_comparators'],
        ],
        ' '.join(map(str, cmd)))

